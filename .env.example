# --- Kontakt forma -----------------------------------------------------------
# Supabase projekat sa edge funkcijom "send-contact-email".
# Ako ovo NIJE popunjeno, forma i dalje radi: prikaže dugmad za slanje prijave
# preko WhatsApp-a, Viber-a ili e-maila sa već popunjenom porukom.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Analitika ---------------------------------------------------------------
# Google Analytics 4 mjerni ID. Prazno = analitika se uopšte ne učitava.
VITE_GA_ID=

# NAPOMENA: i besplatni test znanja (/test-znanja) koristi isti Supabase projekat,
# preko edge funkcije "send-test-result". Ako VITE_SUPABASE_URL nije popunjen,
# test i dalje radi i prikazuje rezultat — samo umjesto automatskog slanja nudi
# dugmad za WhatsApp, Viber i e-mail sa već popunjenim rezultatom.
